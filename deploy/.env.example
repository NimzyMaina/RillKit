# Copy to .env and edit. The installer (deploy/install.sh) writes this for you.
#
# Local Postgres (quick start): keep COMPOSE_PROFILES=local-db, set POSTGRES_PASSWORD and use
# the same password in the URL below. The database is not published outside the Compose network.
#
# Your own Postgres: set RILLKIT_SERVER_DATABASE_URL and remove COMPOSE_PROFILES. Add
# ?sslmode=require for a managed database. Postgres 13 or newer.
#
# The server does not use Redis/Valkey. Workers point RILLKIT_URL at their own Redis or Valkey;
# with RILLKIT_CONTROL=valkey they need no server at all.

COMPOSE_PROFILES=local-db

# edge follows main (the quick-start default). Pin a release in production, e.g. v0.4.0.
RILLKIT_VERSION=edge
# RILLKIT_IMAGE=ghcr.io/nimzymaina/rillkit-server   # override for a mirror

RILLKIT_PORT=8080
RILLKIT_PROJECT_NAME=rillkit

# Generate with: openssl rand -hex 24
RILLKIT_SERVER_ADMIN_TOKEN=

# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# How workers reach this server. Use https:// behind TLS (workers require wss://).
RILLKIT_SERVER_PUBLIC_URL=http://localhost:8080
RILLKIT_SERVER_DATABASE_URL=postgresql://rillkit:CHANGE_ME@postgres:5432/rillkit

# Optional tuning:
# RILLKIT_SERVER_LOG_LEVEL=INFO
# RILLKIT_SERVER_TELEMETRY_INTERVAL_SEC=5
# RILLKIT_SERVER_AUTOSCALE_INTERVAL_SEC=5
# RILLKIT_SERVER_NODE_TTL_SEC=30
