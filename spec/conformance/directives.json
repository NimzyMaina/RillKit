{
  "description": "Validating directives and what applying one writes (spec 2.1, 5.2). 'fields' are the planned state fields; applying also writes 'directive_id' and 'updated_at'. 'reason' is informative, not compared.",
  "cases": [
    {
      "name": "SET_STATE globally",
      "builder": {
        "layout": "plain"
      },
      "directive": {
        "type": "DIRECTIVE",
        "directive_id": "dir_1",
        "cmd": "SET_STATE",
        "scope": "global",
        "params": {
          "state": "PAUSED"
        }
      },
      "expect": {
        "status": "ACCEPTED",
        "cmd": "SET_STATE",
        "key": "rillkit:state:global",
        "channel": "rillkit:ctl:broadcast",
        "fields": {
          "state": "PAUSED"
        }
      }
    },
    {
      "name": "states are case-sensitive",
      "builder": {
        "layout": "plain"
      },
      "directive": {
        "type": "DIRECTIVE",
        "directive_id": "dir_1",
        "cmd": "SET_STATE",
        "scope": "global",
        "params": {
          "state": "draining"
        }
      },
      "expect": {
        "status": "REJECTED",
        "reason": "state must be one of ('RUNNING', 'PAUSED', 'MAINTENANCE', 'DRAINING')"
      }
    },
    {
      "name": "commands are case-sensitive",
      "builder": {
        "layout": "plain"
      },
      "directive": {
        "type": "DIRECTIVE",
        "directive_id": "dir_1",
        "cmd": "set_state",
        "scope": "global",
        "params": {
          "state": "PAUSED"
        }
      },
      "expect": {
        "status": "REJECTED",
        "reason": "unknown cmd 'set_state', expected one of ('SET_STATE', 'SET_CONCURRENCY', 'SET_POLL_CONFIG', 'MAINTENANCE_ON', 'MAINTENANCE_OFF', 'EXECUTE_REPLAY')"
      }
    },
    {
      "name": "scopes are case-sensitive",
      "builder": {
        "layout": "plain"
      },
      "directive": {
        "type": "DIRECTIVE",
        "directive_id": "dir_1",
        "cmd": "SET_STATE",
        "scope": "GLOBAL",
        "params": {
          "state": "PAUSED"
        }
      },
      "expect": {
        "status": "REJECTED",
        "reason": "unknown scope 'GLOBAL', expected one of ('global', 'stream', 'node')"
      }
    },
    {
      "name": "MAINTENANCE_ON for one stream",
      "builder": {
        "layout": "plain"
      },
      "directive": {
        "type": "DIRECTIVE",
        "directive_id": "dir_1",
        "cmd": "MAINTENANCE_ON",
        "scope": "stream",
        "target": {
          "stream": "orders:eu",
          "group": "billing"
        }
      },
      "expect": {
        "status": "ACCEPTED",
        "cmd": "MAINTENANCE_ON",
        "key": "rillkit:state:stream:orders%3Aeu:billing",
        "channel": "rillkit:ctl:broadcast",
        "fields": {
          "state": "MAINTENANCE"
        }
      }
    },
    {
      "name": "MAINTENANCE_OFF",
      "builder": {
        "layout": "plain"
      },
      "directive": {
        "type": "DIRECTIVE",
        "directive_id": "dir_1",
        "cmd": "MAINTENANCE_OFF",
        "scope": "global"
      },
      "expect": {
        "status": "ACCEPTED",
        "cmd": "MAINTENANCE_OFF",
        "key": "rillkit:state:global",
        "channel": "rillkit:ctl:broadcast",
        "fields": {
          "state": "RUNNING"
        }
      }
    },
    {
